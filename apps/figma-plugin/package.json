{
  "name": "@deltaframe/figma-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build -- --watch",
    "build": "node scripts/build-ui.cjs && esbuild src/code.ts --bundle --target=es2017 --format=iife --outfile=dist/code.js",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@deltaframe/core": "0.1.0",
    "@vitejs/plugin-react": "^4.5.1",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.108.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "esbuild": "^0.25.5"
  }
}
